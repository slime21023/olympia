{
  "name": "olympia",
  "version": "0.1.0",
  "private": true,
  "description": "Olympia — Astro + AsciiDoc Technical Documentation Theme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/docs dev",
    "build": "bun --cwd apps/docs build",
    "preview": "bun --cwd apps/docs preview",
    "test": "bun test packages/olympia-theme/tests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --threads=1",
    "fmt:check": "oxfmt --check --threads=1",
    "typecheck": "tsc -p packages/olympia-theme",
    "check": "bun --cwd apps/docs check && bun --cwd packages/olympia-theme check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@types/bun": "latest",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.8.2"
  }
}
