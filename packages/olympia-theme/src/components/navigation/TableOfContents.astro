---
import type { HeadingItem } from '../../types.ts';

export interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <o-toc class="o-toc">
    <div class="o-toc__header">
      <svg class="o-toc__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" d="M2.5 4h11M2.5 8h7.5M2.5 12h9.5" />
      </svg>
      <span>On this page</span>
    </div>
    <ul class="o-toc__list">
      {headings.map((h) => (
        <li class={`o-toc__item o-toc__item--d${h.depth}`}>
          <a href={`#${h.slug}`} class="o-toc__link" data-toc-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </o-toc>
)}

<style>
  .o-toc {
    display: block;
    padding: 1rem 0.75rem;
  }

  .o-toc__header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--o-text-muted);
  }

  .o-toc__icon {
    width: 14px;
    height: 14px;
  }

  .o-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--o-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .o-toc__item {
    margin: 0;
  }

  .o-toc__link {
    position: relative;
    display: block;
    padding: 0.375rem 0.875rem;
    font-size: 13px;
    line-height: 20px;
    color: var(--o-text-muted);
    transition: color 150ms ease;
  }

  .o-toc__item--d3 .o-toc__link {
    padding-left: 1.5rem;
    font-size: 12.5px;
  }

  .o-toc__item--d4 .o-toc__link {
    padding-left: 2.25rem;
    font-size: 12px;
  }

  .o-toc__link:hover {
    color: var(--o-text);
  }

  .o-toc__link[data-active="true"] {
    color: var(--o-primary-text);
    font-weight: 500;
  }

  .o-toc__link[data-active="true"]::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background-color: var(--o-primary);
  }
</style>

<script>
  import './toc.ts';
</script>
