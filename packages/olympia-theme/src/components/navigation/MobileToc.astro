---
import type { HeadingItem } from '../../types.ts';

export interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <details class="o-mobile-toc">
    <summary class="o-mobile-toc__summary">
      <span>On this page</span>
      <svg
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 6 3.5 3.5L11.5 6" />
      </svg>
    </summary>
    <div class="o-mobile-toc__dropdown">
      <ul>
        {headings.map((h) => (
          <li class={`o-mobile-toc__item--d${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </details>
)}

<style>
  .o-mobile-toc {
    position: relative;
  }

  .o-mobile-toc__summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-DEFAULT);
    border: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
    color: var(--o-text-secondary);
    cursor: pointer;
  }

  .o-mobile-toc__summary::-webkit-details-marker {
    display: none;
  }

  .o-mobile-toc__summary svg {
    width: 14px;
    height: 14px;
  }

  .o-mobile-toc__dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 30;
    min-width: 240px;
    padding: 0.625rem;
    background-color: var(--o-surface-overlay);
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .o-mobile-toc__dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .o-mobile-toc__dropdown a {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 13px;
    color: var(--o-text-secondary);
    border-radius: var(--radius-sm);
  }

  .o-mobile-toc__dropdown a:hover {
    background-color: var(--o-surface-high);
    color: var(--o-text);
  }
</style>
