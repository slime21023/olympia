---
export interface Props {
  siteTitle?: string;
  version?: string;
  githubUrl?: string;
}

const {
  siteTitle = 'Olympia',
  version = 'v0.1.0',
  githubUrl = 'https://github.com',
} = Astro.props;
---

<header class="o-header">
  <div class="o-header__inner">
    <div class="o-header__left">
      <button
        type="button"
        id="drawer-open"
        class="o-header__drawer-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="o-mobile-drawer"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" d="M3 5.5h14M3 10h14M3 14.5h10" />
        </svg>
      </button>

      <a href="/" class="o-header__brand">
        <span class="o-header__logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.75" />
            <path d="M7 15.5L12 7.5L17 15.5H7Z" stroke="#6366f1" stroke-width="1.75" stroke-linejoin="round" />
            <circle cx="12" cy="13" r="1.5" fill="#10b981" />
          </svg>
        </span>
        <span class="o-header__title">{siteTitle}</span>
      </a>

      <span class="o-header__version">{version}</span>
    </div>

    <div class="o-header__center">
      <button
        type="button"
        class="o-search-trigger"
        data-search-open
        aria-label="Search documentation (Command or Control + K)"
      >
        <span class="o-search-trigger__left">
          <svg class="o-search-trigger__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="7" cy="7" r="4.75" />
            <path stroke-linecap="round" d="m10.5 10.5 3.25 3.25" />
          </svg>
          <span class="o-search-trigger__placeholder">Search docs, AsciiDoc macros, API...</span>
        </span>
        <span class="o-search-trigger__kbd" aria-hidden="true">
          <kbd class="o-kbd">⌘K</kbd>
        </span>
      </button>
    </div>

    <div class="o-header__right">
      <o-theme-toggle class="o-theme-toggle">
        <button type="button" class="o-icon-btn" aria-label="Toggle color scheme" title="Switch color scheme">
          <svg class="o-theme-icon o-theme-icon--sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10" cy="10" r="3.75" />
            <path stroke-linecap="round" d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" />
          </svg>
          <svg class="o-theme-icon o-theme-icon--moon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 12.8A6.5 6.5 0 0 1 7.2 4.5a6.5 6.5 0 1 0 8.3 8.3Z" />
          </svg>
        </button>
      </o-theme-toggle>

      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="o-icon-btn"
          aria-label="View source on GitHub"
          title="GitHub Repository"
        >
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M10 1.8a8.2 8.2 0 0 0-2.6 15.98c.41.07.56-.18.56-.4v-1.4c-2.28.5-2.76-1.1-2.76-1.1-.37-.95-.91-1.2-.91-1.2-.75-.5.06-.49.06-.49.82.06 1.26.85 1.26.85.73 1.25 1.92.89 2.39.68.07-.53.29-.89.52-1.1-1.82-.2-3.74-.91-3.74-4.06 0-.9.32-1.63.85-2.21-.09-.2-.37-1.04.08-2.17 0 0 .69-.22 2.26.84a7.8 7.8 0 0 1 4.12 0c1.57-1.06 2.26-.84 2.26-.84.45 1.13.17 1.97.08 2.17.53.58.85 1.31.85 2.21 0 3.16-1.92 3.85-3.75 4.05.3.26.56.76.56 1.54v2.28c0 .22.15.48.57.4A8.2 8.2 0 0 0 10 1.8Z"
            />
          </svg>
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .o-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-height);
    background-color: var(--o-header-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--o-border);
  }

  .o-header__inner {
    width: 100%;
    height: 100%;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .o-header__left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .o-header__drawer-btn {
    display: none;
    width: 34px;
    height: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    color: var(--o-text-secondary);
    cursor: pointer;
  }

  .o-header__drawer-btn svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 767px) {
    .o-header__drawer-btn {
      display: inline-flex;
    }
  }

  .o-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.02em;
    color: var(--o-text);
  }

  .o-header__logo {
    display: inline-flex;
    width: 24px;
    height: 24px;
    color: var(--o-text);
  }

  .o-header__version {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 0.125rem 0.45rem;
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--o-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--o-primary) 30%, transparent);
    color: var(--o-primary-text);
  }

  .o-header__center {
    flex: 1;
    max-width: 420px;
    display: flex;
    justify-content: center;
  }

  .o-search-trigger {
    width: 100%;
    height: 34px;
    padding: 0 0.625rem 0 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background-color: var(--o-surface-raised);
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    color: var(--o-text-muted);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .o-search-trigger:hover {
    border-color: var(--o-primary);
    background-color: var(--o-surface-overlay);
    color: var(--o-text);
  }

  .o-search-trigger__left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
  }

  .o-search-trigger__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .o-search-trigger__placeholder {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 639px) {
    .o-search-trigger__placeholder {
      display: none;
    }
    .o-header__center {
      max-width: fit-content;
      margin-left: auto;
    }
  }

  .o-header__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .o-icon-btn {
    width: 34px;
    height: 34px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    color: var(--o-text-muted);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .o-icon-btn:hover {
    background-color: var(--o-surface-overlay);
    color: var(--o-text);
  }

  .o-icon-btn svg {
    width: 17px;
    height: 17px;
  }

  /* Icon display based on active color-scheme */
  .o-theme-icon--moon {
    display: none;
  }

  :global(:root:has(> head > meta[name="color-scheme"][content="light"])) .o-theme-icon--sun {
    display: none;
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="light"])) .o-theme-icon--moon {
    display: block;
  }
</style>

<script>
  import '../elements/theme-toggle.ts';
</script>
