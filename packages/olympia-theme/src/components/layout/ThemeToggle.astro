---
import IconButton from './IconButton.astro';
---

<o-theme-toggle class="o-theme-toggle">
  <IconButton label="Toggle color scheme" title="Switch color scheme">
    <svg class="o-theme-icon o-theme-icon--sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="10" cy="10" r="3.75" />
      <path stroke-linecap="round" d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" />
    </svg>
    <svg class="o-theme-icon o-theme-icon--moon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 12.8A6.5 6.5 0 0 1 7.2 4.5a6.5 6.5 0 1 0 8.3 8.3Z" />
    </svg>
  </IconButton>
</o-theme-toggle>

<script>
  import './theme-toggle.ts';
</script>

<style>
  /* Icon display based on active color-scheme */
  .o-theme-icon--moon {
    display: none;
  }

  :global(:root:has(> head > meta[name="color-scheme"][content="light"])) .o-theme-icon--sun {
    display: none;
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="light"])) .o-theme-icon--moon {
    display: block;
  }
</style>
