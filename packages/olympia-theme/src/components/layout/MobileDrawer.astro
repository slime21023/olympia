---
import Sidebar from '../navigation/Sidebar.astro';
import type { NavGroup } from '../../types.ts';

export interface Props {
  siteTitle: string;
  navGroups: NavGroup[];
  currentPath: string;
}

const { siteTitle, navGroups, currentPath } = Astro.props;
---

<!-- Mobile Navigation Drawer (<dialog> + scroll-snap per modern-web-guidance `navigation-drawer`) -->
<dialog class="o-drawer" id="o-mobile-drawer" aria-label="Navigation drawer">
  <div class="o-drawer__scroller">
    <div class="o-drawer__sheet">
      <div class="o-drawer__top">
        <span class="o-drawer__brand">{siteTitle} Navigation</span>
        <button
          type="button"
          id="drawer-close"
          class="o-drawer__close"
          aria-label="Close navigation menu"
          autofocus
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="m4 4 8 8m0-8-8 8" />
          </svg>
        </button>
      </div>
      <Sidebar groups={navGroups} currentPath={currentPath} />
    </div>
  </div>
</dialog>

<script>
  import './mobile-drawer.ts';
</script>

<style>
  /* Mobile Drawer Styles per modern-web-guidance `navigation-drawer` */
  .o-drawer {
    --drawer-width: min(280px, 82dvw, 100dvw - 24px);
    --drawer-backdrop: 0;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .o-drawer::backdrop {
    background: #000;
    opacity: calc(var(--drawer-backdrop) * 0.6);
  }

  .o-drawer__scroller {
    position: relative;
    display: grid;
    grid-template-columns: var(--drawer-width) 100%;
    overflow-x: scroll;
    overscroll-behavior: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  @media (prefers-reduced-motion: no-preference) {
    .o-drawer__scroller {
      scroll-behavior: smooth;
    }
  }

  .o-drawer__scroller::after {
    content: '';
    scroll-snap-align: end;
    scroll-initial-target: nearest;
  }

  .o-drawer__sheet {
    display: grid;
    /* Without this the implicit auto column grows to the longest nowrap nav link and overflows the sheet. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    height: 100svh;
    background-color: var(--o-surface-raised);
    border-right: 1px solid var(--o-border);
    color: var(--o-text);
    overflow-y: auto;
    scroll-snap-align: start;
    scrollbar-width: none;
  }

  .o-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--o-border);
  }

  .o-drawer__brand {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--o-text-muted);
  }

  .o-drawer__close {
    width: 28px;
    height: 28px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-sm);
    color: var(--o-text-secondary);
    cursor: pointer;
  }

  .o-drawer__close svg {
    width: 14px;
    height: 14px;
  }

  @supports (animation-timeline: scroll()) {
    .o-drawer {
      timeline-scope: --drawer-fade;
      animation: fade-drawer-backdrop linear both;
      animation-timeline: --drawer-fade;
    }

    .o-drawer__scroller {
      scroll-timeline: --drawer-fade x;
    }

    @property --drawer-backdrop {
      syntax: '<number>';
      inherits: true;
      initial-value: 0;
    }

    @keyframes fade-drawer-backdrop {
      0% {
        --drawer-backdrop: 1;
      }
      100% {
        --drawer-backdrop: 0;
      }
    }
  }
</style>
