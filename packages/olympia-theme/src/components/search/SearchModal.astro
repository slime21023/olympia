---
import './search-results.css';
import type { SearchDocItem } from '../../types.ts';

export interface Props {
  docs: SearchDocItem[];
}

const { docs = [] } = Astro.props;
---

<o-search-modal class="o-search-modal" data-docs={JSON.stringify(docs)}>
  <dialog
    id="o-command-palette"
    class="o-cmd-dialog"
    closedby="any"
    aria-label="Command palette search"
  >
    <div class="o-cmd-dialog__container">
      <div class="o-cmd-dialog__header">
        <svg class="o-cmd-dialog__search-icon" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="8" cy="8" r="5.5" />
          <path stroke-linecap="round" d="m12.2 12.2 3.5 3.5" />
        </svg>
        <input
          type="search"
          id="o-cmd-input"
          class="o-cmd-dialog__input"
          placeholder="Search documentation, AsciiDoc syntax, API endpoints..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          class="o-cmd-dialog__close"
          data-search-close
          aria-label="Close search dialog"
        >
          <kbd class="o-kbd">ESC</kbd>
        </button>
      </div>

      <div class="o-cmd-dialog__body" id="o-cmd-results" role="listbox" aria-label="Search results">
        <!-- Populated dynamically via Pagefind + pre-indexed metadata -->
      </div>

      <div class="o-cmd-dialog__footer">
        <div class="o-cmd-dialog__hints">
          <span><kbd class="o-kbd">↑</kbd> <kbd class="o-kbd">↓</kbd> to navigate</span>
          <span><kbd class="o-kbd">↵</kbd> to open</span>
          <span><kbd class="o-kbd">ESC</kbd> to dismiss</span>
        </div>
        <span class="o-cmd-dialog__engine" id="o-cmd-engine-status">Olympia Instant Index</span>
      </div>
    </div>
  </dialog>
</o-search-modal>

<style>
  .o-cmd-dialog {
    margin: 10vh auto auto;
    width: min(640px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-md); /* 12px per DESIGN.md Floating Modals & Command Bars */
    background-color: var(--o-surface-overlay);
    color: var(--o-text);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--o-border-subtle);
    overflow: hidden;
  }

  .o-cmd-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
  }

  .o-cmd-dialog__container {
    display: flex;
    flex-direction: column;
    max-height: 75vh;
  }

  .o-cmd-dialog__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
  }

  .o-cmd-dialog__search-icon {
    width: 18px;
    height: 18px;
    color: var(--o-primary);
    flex-shrink: 0;
  }

  .o-cmd-dialog__input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--o-text);
    font-size: 15px;
    line-height: 22px;
    outline: none;
  }

  .o-cmd-dialog__input::placeholder {
    color: var(--o-text-muted);
  }

  .o-cmd-dialog__close {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .o-cmd-dialog__body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
    max-height: 400px;
  }

  .o-cmd-dialog__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
    font-size: 12px;
    color: var(--o-text-muted);
  }

  .o-cmd-dialog__hints {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .o-cmd-dialog__engine {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 639px) {
    .o-cmd-dialog__hints {
      display: none;
    }
  }
</style>

<script>
  import './search-modal.ts';
</script>
