---
import '../styles/tokens.css';
import '../styles/prose.css';
import 'katex/dist/katex.min.css';
import Header from '../components/layout/Header.astro';
import MobileDrawer from '../components/layout/MobileDrawer.astro';
import PageSubbar from '../components/layout/PageSubbar.astro';
import DocHeader from '../components/content/DocHeader.astro';
import Pagination from '../components/navigation/Pagination.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import TableOfContents from '../components/navigation/TableOfContents.astro';
import SearchModal from '../components/search/SearchModal.astro';
import WebCElements from '../components/content/WebCElements.astro';
import {
  DEFAULT_CATEGORY,
  type BadgeVariant,
  type HeadingItem,
  type NavGroup,
  type NavItem,
  type SearchDocItem,
} from '../types.ts';

export interface Props {
  title: string;
  description?: string;
  category?: string;
  badge?: string;
  badgeVariant?: BadgeVariant;
  httpMethod?: string;
  endpoint?: string;
  headings?: HeadingItem[];
  navGroups?: NavGroup[];
  searchDocs?: SearchDocItem[];
  prevPage?: NavItem | null;
  nextPage?: NavItem | null;
  siteTitle?: string;
  version?: string;
  /** Repository URL for the header's GitHub button; the button is hidden when omitted. */
  githubUrl?: string;
  /** Icon URL for `<link rel="icon">`. Include the base path, e.g. `${import.meta.env.BASE_URL}favicon.svg`. */
  favicon?: string;
  /** Set to `false` for pages that should not be searchable or indexed by search engines (e.g. a 404 page). */
  indexable?: boolean;
}

const {
  title,
  description = '',
  category = DEFAULT_CATEGORY,
  badge,
  badgeVariant = 'primary',
  httpMethod,
  endpoint,
  headings = [],
  navGroups = [],
  searchDocs = [],
  prevPage = null,
  nextPage = null,
  siteTitle = 'Olympia',
  version = 'v0.1.0',
  githubUrl,
  favicon,
  indexable = true,
} = Astro.props;

const currentPath = Astro.url.pathname;
// Needs `site` in the Astro config; the pathname already includes the `base` path.
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- MANDATORY per modern-web-guidance `dark-mode` & `dark-mode-toggle` -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        document.querySelector('meta[name="color-scheme"]').content =
          localStorage.getItem('color-scheme') ?? 'light dark';
      } catch {}
    </script>
    <title>{title} — {siteTitle}</title>
    {description && <meta name="description" content={description} />}
    {favicon && <link rel="icon" href={favicon} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header siteTitle={siteTitle} version={version} githubUrl={githubUrl} />

    <MobileDrawer siteTitle={siteTitle} navGroups={navGroups} currentPath={currentPath} />

    <!-- 3-Column Technical Precision Reference Architecture -->
    <div class="o-workspace">
      <!-- Left Column: Persistent Tree Navigation (260px-280px) -->
      <aside class="o-workspace__sidebar" aria-label="Primary Sidebar">
        <div class="o-workspace__sidebar-sticky">
          <Sidebar groups={navGroups} currentPath={currentPath} />
        </div>
      </aside>

      <!-- Center Column: Documentation Core (Flexible, max 768px) -->
      <main class="o-workspace__main" data-pagefind-body={indexable ? '' : undefined}>
        <!-- Mobile / Tablet Breadcrumb & On-page TOC disclosure -->
        <PageSubbar category={category} title={title} headings={headings} />

        <article class="o-doc-article">
          <DocHeader
            title={title}
            description={description}
            category={category}
            badge={badge}
            badgeVariant={badgeVariant}
            httpMethod={httpMethod}
            endpoint={endpoint}
          />

          <div class="o-prose">
            <slot />
          </div>

          <Pagination prevPage={prevPage} nextPage={nextPage} />
        </article>
      </main>

      <!-- Right Column: Sticky Contextual Rail / TOC (300px) -->
      <aside class="o-workspace__rail" aria-label="On-page table of contents" data-pagefind-ignore>
        <div class="o-workspace__rail-sticky">
          <TableOfContents headings={headings} />
          <slot name="rail" />
        </div>
      </aside>
    </div>

    <SearchModal docs={searchDocs} />
    <WebCElements />
  </body>
</html>

<style>
  .o-workspace {
    width: 100%;
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--toc-width);
    min-height: calc(100svh - var(--header-height));
  }

  .o-workspace__sidebar {
    border-right: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
  }

  .o-workspace__sidebar-sticky {
    position: sticky;
    top: var(--header-height);
    height: calc(100svh - var(--header-height));
    overflow-y: auto;
  }

  .o-workspace__main {
    min-width: 0;
    padding: 2.25rem 2.5rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .o-doc-article {
    width: 100%;
    max-width: var(--prose-max-width);
  }

  .o-workspace__rail {
    border-left: 1px solid var(--o-border);
  }

  .o-workspace__rail-sticky {
    position: sticky;
    top: var(--header-height);
    max-height: calc(100svh - var(--header-height));
    overflow-y: auto;
  }

  /* Tablet Breakpoint (768px - 1279px): 2-Column View */
  @media (max-width: 1279px) {
    .o-workspace {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
    .o-workspace__rail {
      display: none;
    }
    .o-workspace__main {
      padding: 1.25rem 1.25rem 3rem;
    }
  }

  /* Mobile Breakpoint (< 768px): Single-Column Fluid Layout */
  @media (max-width: 767px) {
    .o-workspace {
      grid-template-columns: minmax(0, 1fr);
    }
    .o-workspace__sidebar {
      display: none;
    }
    .o-workspace__main {
      padding: 1.25rem 1rem 3rem;
    }
  }
</style>
