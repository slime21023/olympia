---
import '../styles/tokens.css';
import '../styles/prose.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SearchModal from '../components/SearchModal.astro';
import WebCElements from '../components/WebCElements.astro';
import {
  DEFAULT_CATEGORY,
  type BadgeVariant,
  type HeadingItem,
  type NavGroup,
  type NavItem,
  type SearchDocItem,
} from '../types.ts';

export interface Props {
  title: string;
  description?: string;
  category?: string;
  badge?: string;
  badgeVariant?: BadgeVariant;
  httpMethod?: string;
  endpoint?: string;
  headings?: HeadingItem[];
  navGroups?: NavGroup[];
  searchDocs?: SearchDocItem[];
  prevPage?: NavItem | null;
  nextPage?: NavItem | null;
  siteTitle?: string;
  version?: string;
}

const {
  title,
  description = '',
  category = DEFAULT_CATEGORY,
  badge,
  badgeVariant = 'primary',
  httpMethod,
  endpoint,
  headings = [],
  navGroups = [],
  searchDocs = [],
  prevPage = null,
  nextPage = null,
  siteTitle = 'Olympia',
  version = 'v0.1.0',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- MANDATORY per modern-web-guidance `dark-mode` & `dark-mode-toggle` -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        document.querySelector('meta[name="color-scheme"]').content =
          localStorage.getItem('color-scheme') ?? 'light dark';
      } catch {}
    </script>
    <title>{title} — {siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header siteTitle={siteTitle} version={version} />

    <!-- Mobile Navigation Drawer (<dialog> + scroll-snap per modern-web-guidance `navigation-drawer`) -->
    <dialog class="o-drawer" id="o-mobile-drawer" aria-label="Navigation drawer">
      <div class="o-drawer__scroller">
        <div class="o-drawer__sheet">
          <div class="o-drawer__top">
            <span class="o-drawer__brand">{siteTitle} Navigation</span>
            <button type="button" id="drawer-close" class="o-drawer__close" aria-label="Close navigation menu" autofocus>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" d="m4 4 8 8m0-8-8 8" />
              </svg>
            </button>
          </div>
          <Sidebar groups={navGroups} currentPath={currentPath} />
        </div>
      </div>
    </dialog>

    <!-- 3-Column Technical Precision Reference Architecture -->
    <div class="o-workspace">
      <!-- Left Column: Persistent Tree Navigation (260px-280px) -->
      <aside class="o-workspace__sidebar" aria-label="Primary Sidebar">
        <div class="o-workspace__sidebar-sticky">
          <Sidebar groups={navGroups} currentPath={currentPath} />
        </div>
      </aside>

      <!-- Center Column: Documentation Core (Flexible, max 768px) -->
      <main class="o-workspace__main" data-pagefind-body>
        <!-- Mobile / Tablet Breadcrumb & On-page TOC disclosure -->
        <div class="o-subbar">
          <div class="o-breadcrumb">
            <span class="o-breadcrumb__cat">{category}</span>
            <span class="o-breadcrumb__sep" aria-hidden="true">/</span>
            <span class="o-breadcrumb__current">{title}</span>
          </div>

          {headings.length > 0 && (
            <details class="o-mobile-toc">
              <summary class="o-mobile-toc__summary">
                <span>On this page</span>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 6 3.5 3.5L11.5 6" />
                </svg>
              </summary>
              <div class="o-mobile-toc__dropdown">
                <ul>
                  {headings.map((h) => (
                    <li class={`o-mobile-toc__item--d${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          )}
        </div>

        <article class="o-doc-article">
          <header class="o-doc-header">
            <div class="o-doc-header__eyebrow">
              <span class="o-doc-header__category">{category}</span>
              {badge && (
                <span class={`o-doc-badge o-doc-badge--${badgeVariant}`}>{badge}</span>
              )}
              {httpMethod && endpoint && (
                <span class="o-doc-endpoint-pill">
                  <span class={`o-code-verb o-code-verb--${httpMethod.toLowerCase()}`}>
                    {httpMethod.toUpperCase()}
                  </span>
                  <code class="o-doc-endpoint-path">{endpoint}</code>
                </span>
              )}
            </div>
            <h1 class="o-doc-title">{title}</h1>
            {description && <p class="o-doc-lead">{description}</p>}
          </header>

          <div class="o-prose">
            <slot />
          </div>

          {(prevPage || nextPage) && (
            <nav class="o-pagination" aria-label="Document pagination" data-pagefind-ignore>
              {prevPage ? (
                <a href={prevPage.href} class="o-pagination__card o-pagination__card--prev">
                  <span class="o-pagination__dir">← Previous</span>
                  <span class="o-pagination__title">{prevPage.title}</span>
                </a>
              ) : (
                <div />
              )}
              {nextPage && (
                <a href={nextPage.href} class="o-pagination__card o-pagination__card--next">
                  <span class="o-pagination__dir">Next →</span>
                  <span class="o-pagination__title">{nextPage.title}</span>
                </a>
              )}
            </nav>
          )}
        </article>
      </main>

      <!-- Right Column: Sticky Contextual Rail / TOC (300px) -->
      <aside class="o-workspace__rail" aria-label="On-page table of contents" data-pagefind-ignore>
        <div class="o-workspace__rail-sticky">
          <TableOfContents headings={headings} />
          <slot name="rail" />
        </div>
      </aside>
    </div>

    <SearchModal docs={searchDocs} />
    <WebCElements />

    <script>
      import '../scripts/mobile-drawer.ts';
    </script>
  </body>
</html>

<style>
  .o-workspace {
    width: 100%;
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--toc-width);
    min-height: calc(100svh - var(--header-height));
  }

  .o-workspace__sidebar {
    border-right: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
  }

  .o-workspace__sidebar-sticky {
    position: sticky;
    top: var(--header-height);
    height: calc(100svh - var(--header-height));
    overflow-y: auto;
  }

  .o-workspace__main {
    min-width: 0;
    padding: 2.25rem 2.5rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .o-doc-article {
    width: 100%;
    max-width: var(--prose-max-width);
  }

  .o-workspace__rail {
    border-left: 1px solid var(--o-border);
  }

  .o-workspace__rail-sticky {
    position: sticky;
    top: var(--header-height);
    max-height: calc(100svh - var(--header-height));
    overflow-y: auto;
  }

  /* Subbar for Tablet & Mobile */
  .o-subbar {
    display: none;
    width: 100%;
    max-width: var(--prose-max-width);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--o-border);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .o-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--o-text-muted);
  }

  .o-breadcrumb__current {
    color: var(--o-text);
    font-weight: 500;
  }

  .o-mobile-toc {
    position: relative;
  }

  .o-mobile-toc__summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-DEFAULT);
    border: 1px solid var(--o-border);
    background-color: var(--o-surface-raised);
    color: var(--o-text-secondary);
    cursor: pointer;
  }

  .o-mobile-toc__summary::-webkit-details-marker {
    display: none;
  }

  .o-mobile-toc__summary svg {
    width: 14px;
    height: 14px;
  }

  .o-mobile-toc__dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 30;
    min-width: 240px;
    padding: 0.625rem;
    background-color: var(--o-surface-overlay);
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .o-mobile-toc__dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .o-mobile-toc__dropdown a {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 13px;
    color: var(--o-text-secondary);
    border-radius: var(--radius-sm);
  }

  .o-mobile-toc__dropdown a:hover {
    background-color: var(--o-surface-high);
    color: var(--o-text);
  }

  /* Document Header */
  .o-doc-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--o-border);
  }

  .o-doc-header__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .o-doc-header__category {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--o-primary-text);
  }

  .o-doc-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.125rem 0.45rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .o-doc-badge--primary {
    background-color: color-mix(in srgb, var(--o-primary) 15%, transparent);
    color: var(--o-primary-text);
    border: 1px solid color-mix(in srgb, var(--o-primary) 35%, transparent);
  }

  .o-doc-badge--secondary {
    background-color: color-mix(in srgb, var(--o-secondary) 15%, transparent);
    color: var(--o-secondary);
    border: 1px solid color-mix(in srgb, var(--o-secondary) 35%, transparent);
  }

  .o-doc-badge--tertiary {
    background-color: color-mix(in srgb, var(--o-tertiary) 15%, transparent);
    color: var(--o-tertiary);
    border: 1px solid color-mix(in srgb, var(--o-tertiary) 35%, transparent);
  }

  .o-doc-endpoint-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.15rem 0.5rem 0.15rem 0.25rem;
    background-color: var(--o-surface-raised);
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
  }

  .o-doc-endpoint-path {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--o-text);
  }

  .o-doc-title {
    margin: 0 0 1rem;
    font-size: 36px;
    line-height: 44px;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--o-text);
  }

  .o-doc-lead {
    margin: 0;
    font-size: 16.5px;
    line-height: 28px;
    color: var(--o-text-muted);
  }

  /* Pagination Cards */
  .o-pagination {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--o-border);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .o-pagination__card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-DEFAULT);
    background-color: var(--o-surface);
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .o-pagination__card:hover {
    border-color: var(--o-primary);
    background-color: var(--o-surface-raised);
  }

  .o-pagination__card--next {
    text-align: right;
  }

  .o-pagination__dir {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--o-text-muted);
  }

  .o-pagination__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--o-text);
  }

  /* Tablet Breakpoint (768px - 1279px): 2-Column View */
  @media (max-width: 1279px) {
    .o-workspace {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
    .o-workspace__rail {
      display: none;
    }
    .o-subbar {
      display: flex;
    }
    .o-workspace__main {
      padding: 1.25rem 1.25rem 3rem;
    }
  }

  /* Mobile Breakpoint (< 768px): Single-Column Fluid Layout */
  @media (max-width: 767px) {
    .o-workspace {
      grid-template-columns: minmax(0, 1fr);
    }
    .o-workspace__sidebar {
      display: none;
    }
    .o-workspace__main {
      padding: 1.25rem 1rem 3rem;
    }
    .o-doc-title {
      font-size: 28px;
      line-height: 36px;
      letter-spacing: -0.02em;
    }
    .o-pagination {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile Drawer Styles per modern-web-guidance `navigation-drawer` */
  .o-drawer {
    --drawer-width: min(280px, 82dvw, 100dvw - 24px);
    --drawer-backdrop: 0;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .o-drawer::backdrop {
    background: #000;
    opacity: calc(var(--drawer-backdrop) * 0.6);
  }

  .o-drawer__scroller {
    position: relative;
    display: grid;
    grid-template-columns: var(--drawer-width) 100%;
    overflow-x: scroll;
    overscroll-behavior: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  @media (prefers-reduced-motion: no-preference) {
    .o-drawer__scroller {
      scroll-behavior: smooth;
    }
  }

  .o-drawer__scroller::after {
    content: '';
    scroll-snap-align: end;
    scroll-initial-target: nearest;
  }

  .o-drawer__sheet {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
    background-color: var(--o-surface-raised);
    border-right: 1px solid var(--o-border);
    color: var(--o-text);
    overflow-y: auto;
    scroll-snap-align: start;
    scrollbar-width: none;
  }

  .o-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--o-border);
  }

  .o-drawer__brand {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--o-text-muted);
  }

  .o-drawer__close {
    width: 28px;
    height: 28px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--o-border);
    border-radius: var(--radius-sm);
    color: var(--o-text-secondary);
    cursor: pointer;
  }

  .o-drawer__close svg {
    width: 14px;
    height: 14px;
  }

  @supports (animation-timeline: scroll()) {
    .o-drawer {
      timeline-scope: --drawer-fade;
      animation: fade-drawer-backdrop linear both;
      animation-timeline: --drawer-fade;
    }

    .o-drawer__scroller {
      scroll-timeline: --drawer-fade x;
    }

    @property --drawer-backdrop {
      syntax: '<number>';
      inherits: true;
      initial-value: 0;
    }

    @keyframes fade-drawer-backdrop {
      0% {
        --drawer-backdrop: 1;
      }
      100% {
        --drawer-backdrop: 0;
      }
    }
  }
</style>
